    "db:check:activity": "cross-env NODE_ENV=development tsx src/scripts/checkActivityMigration.ts",
    "db:check:activity:prod": "cross-env NODE_ENV=production tsx src/scripts/checkActivityMigration.ts",
    "storage:reconcile": "cross-env NODE_ENV=development tsx src/scripts/reconcileStorage.ts",
    "postinstall": "prisma generate"
  },
