PORT=5000
NODE_ENV=development

# Database connections
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm_dev"

# Authentication / JWT Secrets (Minimum 32 characters)
JWT_SECRET="your-32-character-minimum-access-token-secret-here"
JWT_REFRESH_SECRET="your-32-character-minimum-refresh-token-secret-here"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Super Admin initial seed credentials
SUPER_ADMIN_EMAIL="super@example.com"
SUPER_ADMIN_PASSWORD="change-me-to-a-strong-password"

# Platform Internal Scheduler Secret (Minimum 32 characters)
INTERNAL_JOB_SECRET="your-32-character-minimum-internal-job-secret-here"

# CORS & Server Config
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# Email: sent only through Resend's HTTP API (there is no SMTP).
# Without RESEND_API_KEY the app still boots, but signup and password-reset
# codes cannot be sent. RESEND_FROM_ADDRESS must be a bare address on a domain
# verified in Resend; the default onboarding@resend.dev only reaches the
# Resend account owner.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_ADDRESS="no-reply@example.com"
RESEND_FROM_NAME="CRM Support"

# Business timezone + in-process follow-up scheduler (see docs/scheduled-jobs.md)
APP_TIMEZONE="Asia/Kolkata"
ENABLE_IN_PROCESS_SCHEDULER=true
SCHEDULER_CRON_EXPRESSION="* * * * *"

# Razorpay (optional; required for plan payments and the payment webhook)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# File storage: "local" (uploads/ on disk) or "r2".
# All R2_* values are required in production when STORAGE_PROVIDER=r2.
STORAGE_PROVIDER="local"
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_CUSTOM_DOMAIN=
